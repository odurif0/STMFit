#!/usr/bin/env bash
#SBATCH --job-name=stmfit-unknown25
#SBATCH --time=24:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=16000MB
#SBATCH --output=results/reconstructed_cc_soft_v1/unknown25-resume-%j.log
set -euo pipefail

# Separate unknown25 continuation; never resubmit failed job 30271312.
# Required environment: STMFIT_PROJECT_DIR, JULIA_BIN (1.13), STMFIT_INPUT_DIR,
# STMFIT_OUTDIR (new root; native predictions/QC/maps go in its unknown25/).
# Inputs: unknown_raw/, templates_cc.tsv, unknown25_selected_summary.tsv (original),
# unknown25_base_features.tsv (complete), unknown25_split_partial.tsv (both focused files).
# Metadata only, no SXM reads, fits or output writes:
#   bash hpc/resume_reconstructed_unknown25.sbatch --dry-run
# Submit from the synced project root; the Slurm log parent directory must exist.
export STMFIT_RESUME_DRY_RUN=0
case "${1:-}" in
    "") [[ $# -eq 0 ]] || exit 2 ;;
    --dry-run) [[ $# -eq 1 ]] || exit 2; export STMFIT_RESUME_DRY_RUN=1 ;;
    *) echo "Usage: $0 [--dry-run]" >&2; exit 2 ;;
esac
cd "${STMFIT_PROJECT_DIR:?Set the synced project directory}"
: "${JULIA_BIN:?Set the Julia 1.13 executable}"
: "${STMFIT_INPUT_DIR:?Set the prepared continuation input directory}"
: "${STMFIT_OUTDIR:?Set a new output root directory}"
export GKSwstype=100
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export JULIA_NUM_THREADS="${SLURM_CPUS_PER_TASK:-4}"

exec "$JULIA_BIN" -t "$JULIA_NUM_THREADS" --project=. -e '
include("test/run_reconstructed_chitosan.jl")
module SelectedSupportContext
    include("test/extract_lobe_features.jl")
end

function resume_unknown25()
    VERSION.major == 1 && VERSION.minor == 13 || error("Julia 1.13 is required")
    input = abspath(ENV["STMFIT_INPUT_DIR"])
    outdir = abspath(ENV["STMFIT_OUTDIR"])
    (ispath(outdir) || islink(outdir)) && error("Output directory already exists: $outdir")
    selected = joinpath(input, "unknown25_selected_summary.tsv")
    base = joinpath(input, "unknown25_base_features.tsv")
    partial = joinpath(input, "unknown25_split_partial.tsv")
    templates = joinpath(input, "templates_cc.tsv")
    rawdir = joinpath(input, "unknown_raw")
    count_config = abspath("config/chitosan_10_20mer_adaptive_support_rescue.toml")
    unit_config = abspath("config/unit_assignment_reconstructed.toml")
    for path in (selected, base, partial, templates)
        isfile(path) || error("Missing prepared input: $path")
    end
    counts = selected_counts(selected)
    length(counts) == 25 || error("This continuation requires the 25-file selected summary")
    split_cfg = TOML.parsefile(count_config)
    contexts = SelectedSupportContext._read_selected_context(selected;
        selection_policy=String(get(split_cfg["model"], "selection_policy", "")))
    any(ctx -> ctx.use_rescue, values(contexts)) &&
        SelectedSupportContext._selected_rescue_settings(split_cfg["model"])
    check_counts(base, counts)
    base_header, _ = lobe_table(base)
    partial_header, partial_rows = lobe_table(partial; required=["skew_ratio"])
    base_header == partial_header || error("Cached base/split feature headers differ")
    cached_files = Set(first(key) for key in keys(partial_rows))
    cached_files == Set(["260215_022.sxm", "260220_083.sxm"]) ||
        error("Partial split input must contain both focused files, and no other file")
    issubset(cached_files, Set(keys(counts))) || error("Cached split file absent from selected summary")
    check_counts(partial, Dict(file => counts[file] for file in cached_files))
    remaining = Dict(file => n for (file, n) in counts if !(file in cached_files))
    index = raw_index(rawdir)
    Set(keys(index)) == Set(keys(counts)) || error("Raw/selected-summary basenames differ")
    all(isfile, values(index)) || error("Missing raw SXM target")

    # Exactly the split config generated by the native runner; no retuning.
    cfg = load_config(unit_config)
    split_cfg["model"]["peak_profile"] = "split"
    split_cfg["model"]["skew_ratio_max"] = cfg["model"]["split_skew_ratio_max"]
    println("Julia ", VERSION, "; selected: ", length(counts), " files / ", sum(values(counts)), " lobes")
    println("Reuse complete base and ", length(cached_files), " split files / ", length(partial_rows), " lobes")
    println("Split refits: ", length(remaining), " files / ", sum(values(remaining)),
            " lobes; at most ", min(Threads.nthreads(), 4), " single-thread children")
    println("Native application only -> ", joinpath(outdir, "unknown25"))
    if ENV["STMFIT_RESUME_DRY_RUN"] == "1"
        println("Dry-run: keys and selected-support metadata checked; no SXM reads, fits or output writing.")
        return
    end

    mkpath(dirname(outdir))
    mkdir(outdir) # Refuse an output created since the preflight as well.
    mkdir(joinpath(outdir, "logs"))
    raw = prepare_raw(rawdir, outdir, keys(counts))
    split_config = joinpath(outdir, "split_config.toml")
    open(io -> TOML.print(io, split_cfg), split_config, "w")
    exclude = joinpath(outdir, "cached_split_files.txt")
    open(io -> println(io, join(sort(collect(cached_files)), "\n")), exclude, "w")
    new_split = joinpath(outdir, "features_split_new.tsv")
    export_features(outdir, "split_remaining", "extract_lobe_features.jl",
        ["--config", split_config, "--data-dir", raw, "--selected-summary", selected,
         "--exclude-from", exclude], new_split; nfiles=length(remaining))
    check_counts(new_split, remaining)
    complete_split = joinpath(outdir, "features_split_complete.tsv")
    merge_feature_chunks([partial, new_split], complete_split)
    check_counts(complete_split, counts)
    run_stage(outdir, "unknown25", "run_reconstructed_chitosan.jl",
        ["--data-dir", raw, "--count-config", count_config, "--config", unit_config,
         "--selected-summary", selected, "--features", base, "--split-features", complete_split,
         "--templates", templates, "--outdir", joinpath(outdir, "unknown25")])
end
resume_unknown25()
'
