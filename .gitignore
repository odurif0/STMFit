*.log
results/
**/results/
**/Manifest.toml
!.julia/Manifest.toml
.DS_Store
.theme
# Personal HPC config (MPCDF username + paths) — keep the .example tracked
hpc/remote.env
.claude/settings.local.json
.ignore
chitosan_sensitivity_*.toml
results/sensitivity/
# Raw SXM data lives outside the repo (lab storage / MPCDF ptmp).
# Keep data/README.md and data/.gitkeep tracked, ignore everything else.
data/*
!data/README.md
!data/.gitkeep
docs/build/
# Quantum ESPRESSO run directories can contain large scratch/cube outputs.
qe/
# Python bytecode caches (generated).
__pycache__/

# OpenCode agent session state (never part of the project).
.omo/
.slim/deepwork/
# Agent/tool state and CI workflows kept out of the public repo.
.claude/
.cortexkit/
.github/
# Temporary working directories (.tmp-*) created by scripts/agent probes.
.tmp*/
