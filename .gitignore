*.log
results/
**/results/
**/Manifest.toml
# The root Manifest is tracked for reproducible releases (packages/ ones stay ignored).
!/Manifest.toml
.DS_Store
# All data live in data/ (raw store, sets, index), untracked.
# Keep data/README.md and data/.gitkeep tracked, ignore everything else.
data/*
!data/README.md
!data/.gitkeep
docs/build/
# Quantum ESPRESSO run directories (accepted states, large cubes): untracked.
dft/runs/
# Python bytecode caches (generated).
__pycache__/

# Agent and tool state (never part of the project).
.omo/
.slim/
.claude/
.cortexkit/
.codex/
.agents/
.ruff_cache/
.github/
# Temporary working directories (.tmp-*) created by scripts/agent probes.
.tmp*/
